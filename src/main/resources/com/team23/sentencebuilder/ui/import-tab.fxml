<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.team23.sentencebuilder.ui.ImportController">
  <padding>
    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
  </padding>

  <top>
    <VBox spacing="8.0">
      <padding>
        <Insets bottom="8.0"/>
      </padding>

      <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Button fx:id="importButton" mnemonicParsing="false" onAction="#onImportClicked"
                text="Import Text File..."/>
        <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onCancelClicked"
                disable="true" text="Cancel"/>
        <Button fx:id="clearButton" mnemonicParsing="false" onAction="#onClearClicked"
                text="Clear Session"/>
        <Label fx:id="statusLabel" text="No file imported yet. Choose a text file to begin."
               HBox.hgrow="ALWAYS"/>
      </HBox>

      <HBox>
        <ProgressBar fx:id="progressBar" minHeight="18.0" progress="0.0" HBox.hgrow="ALWAYS"/>
      </HBox>
    </VBox>
  </top>

  <center>
    <SplitPane dividerPositions="0.3">
      <items>
        <VBox spacing="6.0">
          <Label style="-fx-font-weight: bold;" text="Imported files"/>
          <TableView fx:id="filesTable" VBox.vgrow="ALWAYS">
            <columns>
              <TableColumn fx:id="fileNameColumn" prefWidth="150.0" text="File"/>
              <TableColumn fx:id="fileWordsColumn" prefWidth="80.0" text="Words"/>
              <TableColumn fx:id="fileSentencesColumn" prefWidth="90.0" text="Sentences"/>
              <TableColumn fx:id="fileNewWordsColumn" prefWidth="80.0" text="New words"/>
              <TableColumn fx:id="importedAtColumn" prefWidth="140.0" text="Imported"/>
            </columns>
          </TableView>
        </VBox>

        <VBox spacing="6.0">
          <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label style="-fx-font-weight: bold;" text="Words and counts"/>
            <Label fx:id="wordsLabel" text="No words yet" HBox.hgrow="ALWAYS"/>
            <Label text="Filter:"/>
            <TextField fx:id="filterField" prefWidth="200.0" promptText="type to filter words"/>
          </HBox>
          <TableView fx:id="wordsTable" VBox.vgrow="ALWAYS">
            <columns>
              <TableColumn fx:id="wordColumn" prefWidth="240.0" text="Word"/>
              <TableColumn fx:id="countColumn" prefWidth="110.0" text="Occurrences"/>
              <TableColumn fx:id="startsColumn" prefWidth="120.0" text="Sentence starts"/>
              <TableColumn fx:id="endsColumn" prefWidth="120.0" text="Sentence ends"/>
            </columns>
          </TableView>
        </VBox>
      </items>
    </SplitPane>
  </center>
</BorderPane>
