<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.utdallas.sentencebuilder.ui.GenerateController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <Label text="Generate sentences" styleClass="h1"/>
    <Label styleClass="hint" wrapText="true"
           text="Give a starting word, or let the program pick one at random (weighted by how often each word starts a sentence). Every sentence is recorded in the history, and you can feed the batch back in as new input text."/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Start word"/>
        <TextField fx:id="startWord" prefColumnCount="14" promptText="e.g. the"/>
        <CheckBox fx:id="randomStart" text="Random start word for each sentence"/>
        <Label text="Algorithm"/>
        <ComboBox fx:id="generator" prefWidth="180"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Sentences"/>
        <Spinner fx:id="count" prefWidth="80"/>
        <Label text="Min words"/>
        <Spinner fx:id="minWords" prefWidth="80"/>
        <Label text="Max words"/>
        <Spinner fx:id="maxWords" prefWidth="80"/>
        <Button fx:id="generateButton" text="Generate" onAction="#onGenerate" defaultButton="true" styleClass="primary"/>
        <Button text="Clear" onAction="#onClear"/>
    </HBox>
    <Label fx:id="algorithmHint" styleClass="hint" wrapText="true"/>
    <ListView fx:id="results" VBox.vgrow="ALWAYS"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="feedBackButton" text="Add these sentences to the corpus" onAction="#onFeedBack" disable="true"/>
        <Label fx:id="status" text=""/>
    </HBox>
</VBox>
