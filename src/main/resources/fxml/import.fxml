<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<SplitPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="edu.utdallas.sentencebuilder.ui.ImportController"
           orientation="VERTICAL" dividerPositions="0.45">
    <VBox spacing="8">
        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
        <Label text="Import text files" styleClass="h1"/>
        <Label styleClass="hint" wrapText="true"
               text="Plain-text files only (Project Gutenberg's .txt downloads work well). Each file is read once, split into words and sentences, and the counts are merged into the database."/>
        <HBox spacing="8">
            <Button text="Add files…" onAction="#onAddFiles"/>
            <Button text="Remove selected" onAction="#onRemove"/>
            <Button text="Clear" onAction="#onClear"/>
            <Button fx:id="importButton" text="Import all" onAction="#onImport" defaultButton="true" styleClass="primary"/>
            <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" disable="true"/>
        </HBox>
        <ListView fx:id="queue" VBox.vgrow="ALWAYS"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <ProgressBar fx:id="progress" prefWidth="320" progress="0"/>
            <Label fx:id="status" text="No files queued." HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>
    <VBox spacing="8">
        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Import history" styleClass="h1"/>
            <Button text="Refresh" onAction="#refresh"/>
        </HBox>
        <TableView fx:id="history" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" text="Name" prefWidth="300"/>
                <TableColumn fx:id="colSource" text="Source" prefWidth="110"/>
                <TableColumn fx:id="colWords" text="Words" prefWidth="90"/>
                <TableColumn fx:id="colSentences" text="Sentences" prefWidth="90"/>
                <TableColumn fx:id="colDistinct" text="Distinct" prefWidth="80"/>
                <TableColumn fx:id="colNew" text="New words" prefWidth="90"/>
                <TableColumn fx:id="colSize" text="Size" prefWidth="80"/>
                <TableColumn fx:id="colTime" text="Took" prefWidth="70"/>
                <TableColumn fx:id="colWhen" text="Imported" prefWidth="140"/>
            </columns>
        </TableView>
    </VBox>
</SplitPane>
